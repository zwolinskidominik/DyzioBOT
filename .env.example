# Discord 
TOKEN=YOUR_OWN_TOKEN
CLIENT_ID=YOUR_OWN_CLIENT_ID
GUILD_ID=YOUR_OWN_GUILD_ID

# Developers only
DEV_GUILD_IDS=DEV_GUILD_ID1,DEV_GUILD_ID2
DEV_USER_IDS=DEV_USER_ID1,DEV_USER_ID2
DEV_ROLE_IDS=DEV_ROLE_ID1,DEV_ROLE_ID2

TOURNAMENT_CHANNEL_ID=YOUR_OWN_TOURNAMENT_CHANNEL_ID

# Database
MONGODB_URI=YOUR_OWN_MONGODB_URI

# Integracje opcjonalne
TWITCH_CLIENT_ID=YOUR_OWN_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_OWN_TWITCH_CLIENT_SECRET
FACEIT_API_KEY=YOUR_OWN_FACEIT_API_KEY

# Usuwanie danych serwerów 30 dni po usunięciu bota (opisane w polityce prywatności).
# Ustaw "on" TYLKO w .env produkcji. Instancja developerska widzi inne serwery niż produkcja,
# więc z włączoną retencją uznałaby serwery produkcyjne za opuszczone.
# GUILD_DATA_RETENTION=on

# Alerty o kopiach zapasowych bazy w prywatnej wiadomości (tylko produkcja, VPS).
# Wpisz swoje ID konta Discord (Tryb dewelopera → PPM na siebie → Kopiuj ID użytkownika).
# BACKUP_ALERT_USER_ID=123456789012345678

# Ekonomia (opcjonalne overrides — domyślnie ustawiane per-guild w EconomyConfig)
# ECONOMY_DEFAULT_CURRENCY_NAME=Żetony
# ECONOMY_DEFAULT_CURRENCY_SYMBOL=ŻT
# ECONOMY_DEFAULT_CURRENCY_EMOJI=🎰

# Serwer Minecraft GameZone (komenda /minecraft, licznik, whitelista) - tylko produkcja.
# Brak którejś z wymaganych zmiennych = funkcja wyłączona, reszta bota działa normalnie.
# MC_GUILD_ID=ID_serwera_Discord_GameZone
# Rola, która może uruchamiać serwer; bot nadaje ją przy dodaniu do whitelisty i zabiera przy usunięciu
# (potrzebne uprawnienie „Zarządzanie rolami” i rola bota wyżej niż ta rola).
# MC_STARTER_ROLE_ID=ID_roli_ktora_moze_uruchamiac_serwer
# MC_HOST=mc.deezy.cc
# MC_PORT=25565
# MC_RCON_PORT=25575
# MC_CONTROL_URL=https://gamezone-control-788586397732.europe-west3.run.app
# MC_CONTROL_TOKEN=SEKRET_Z_USLUGI_GAMEZONE_CONTROL
# MC_RCON_PASSWORD=HASLO_RCON
# Opcjonalnie: po tym bot rozpoznaje swój serwer w odpowiedzi pingu (domyślnie jak niżej).
# MC_EXPECTED_MOTD=GameZone Pack v5
# MC_EXPECTED_VERSION=1.20.1
