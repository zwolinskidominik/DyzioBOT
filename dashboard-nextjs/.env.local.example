# Discord OAuth2
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# Publiczne ID aplikacji (link "Dodaj bota"); trafia do przeglądarki, więc tylko ID, nigdy sekret.
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id
# Opcjonalnie: wydawca OAuth (domyślnie https://discord.com)
# DISCORD_OAUTH_ISSUER=https://discord.com

# Token bota (odczyt kanałów/ról/członków, emoji bota, wdrażanie paneli) - tylko po stronie serwera
DISCORD_BOT_TOKEN=your_discord_bot_token

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# MongoDB
MONGODB_URI=mongodb://localhost:27017/deezybot

# Redis (limit zapytań, cache). Na produkcji ustawiane w docker-compose.yml.
# REDIS_URL=redis://localhost:6379

# Twitch (moduł Streamy, opcjonalnie)
# TWITCH_CLIENT_ID=your_twitch_client_id
# TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Node Environment
NODE_ENV=development
