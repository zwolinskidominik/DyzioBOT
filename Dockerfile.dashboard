# Builder stage
# Node 22 LTS (Node 20 nie dostaje już poprawek bezpieczeństwa).
FROM node:22-alpine AS builder

WORKDIR /app

# Build-time argument dla NEXT_PUBLIC_
ARG NEXT_PUBLIC_DISCORD_CLIENT_ID
ENV NEXT_PUBLIC_DISCORD_CLIENT_ID=${NEXT_PUBLIC_DISCORD_CLIENT_ID}

# Banner panelu ticketów rysuje @napi-rs/canvas z gotowymi binarkami (także dla musl/Alpine),
# więc nie potrzeba kompilatora ani bibliotek cairo.
COPY package*.json ./
COPY tsconfig.json ./
COPY next.config.ts ./
COPY tailwind.config.ts ./
COPY postcss.config.mjs ./

RUN npm ci

COPY public ./public
COPY src ./src

RUN npm run build

# Production stage
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

# Gotowe node_modules z buildera. Zawiera też typescript (potrzebny dla next.config.ts).
COPY --from=builder /app/node_modules ./node_modules
# .next należy do `node` - Next zapisuje tam cache (np. optymalizacja obrazków) w trakcie działania.
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder /app/public ./public
COPY next.config.ts ./next.config.ts

# Assets będą montowane jako volume, nie kopiujemy ich podczas buildu

EXPOSE 3000

# Panel działa jako zwykły użytkownik `node` (uid 1000), nie root. Uploady powitań idą do
# zamontowanego /assets - na VPS katalog ./assets musi należeć do uid 1000 (patrz Dockerfile.bot).
USER node

CMD ["npm", "start"]
