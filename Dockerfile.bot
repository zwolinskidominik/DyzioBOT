# Builder stage
# Node 22 LTS (Node 20 nie dostaje już poprawek bezpieczeństwa).
FROM node:22-slim AS builder

WORKDIR /app

# Grafiki rysuje @napi-rs/canvas z gotowymi binarkami (Skia) - bez kompilacji i bez bibliotek cairo.
COPY package*.json ./
COPY tsconfig.json ./
COPY tsconfig.build.json ./

RUN npm ci

COPY src ./src
COPY assets ./assets

RUN rm -rf dist && npm run build

# Production stage
FROM node:22-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# Gotowe node_modules z buildera (te same binarki, które przeszły `npm run build`).
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY assets ./assets

# Bot działa jako zwykły użytkownik `node` (uid 1000), nie root. Zapisuje tylko logi i miniatury
# streamów w assets/ - na VPS katalogi ./logs i ./assets (montowane w docker-compose) muszą
# należeć do uid 1000: sudo chown -R 1000:1000 logs assets
RUN mkdir -p /app/logs && chown -R node:node /app/logs /app/assets
USER node

CMD ["node", "dist/index.js"]
