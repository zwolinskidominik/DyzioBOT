# Konto administratora (root) lokalnego MongoDB — tworzone przy pierwszym starcie kontenera.
# Skopiuj do mongo.env (gitignored) i ustaw własne hasło:
#   cp mongo.env.example mongo.env && sed -i "s/CHANGE_ME/$(openssl rand -hex 24)/" mongo.env
# Bot i dashboard NIE używają tego konta — mają własnego użytkownika (ops/mongo/init-replica.sh).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
