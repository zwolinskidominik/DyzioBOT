{
  "name": "deezybot",
  "version": "2.1.0",
  "main": "dist/index.js",
  "scripts": {
    "check:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "dev": "nodemon --exec \"node --no-deprecation -r tsx/cjs\" --watch src src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "mutate": "stryker run",
    "sync-commands": "tsx src/scripts/syncCommands.ts"
  },
  "keywords": [],
  "author": "Dominik Zwoliński",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Easy-to-use Discord BOT with many features.",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@twurple/api": "^7.3.0",
    "@twurple/auth": "^7.3.0",
    "@typegoose/typegoose": "^13.5.0",
    "cheerio": "^1.0.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.5.0",
    "lodash": "^4.17.21",
    "mongoose": "~9.9.5",
    "node-cron": "^4.6.0",
    "pretty-ms": "^9.2.0",
    "undici": "^7.30.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.18.6",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "mongodb-memory-server@10.4.3": true,
    "@parcel/watcher": false,
    "unrs-resolver": false
  },
  "overrides": {
    "encoding-sniffer": "^1.0.2",
    "test-exclude": "^8.0.0"
  }
}
